// Storycrat Worker configuration.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storycrat",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Required later for PDF generation libraries and Resend/Polar SDK-style fetch code.
  "compatibility_flags": ["nodejs_compat"],
  // Launch-blocking attestation (security-doc.md § Third-Party Data Exposure):
  // Zero Data Retention confirmed enabled in Groq Data Controls on 2026-08-23
  // (attested by repo owner — see tasks/launch-checklist.md). The router's
  // fail-closed guard stays in place: only the exact string "true" passes.
  "vars": {
    "GROQ_ZDR_CONFIRMED": "true"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "storycrat-db",
      "database_id": "db33e2f3-c5ee-42cf-a39a-9bb33f3ae34f",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "4e97c8c3304743a080902eb545cac364"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PDFS",
      "bucket_name": "storycrat-exported-pdfs"
    }
  ],
  // Workers AI — embedding generation for the RAG pipeline (Task 4.8).
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      // Semantic index over every script/story bible, chunked by scene.
      // Every upsert/delete/query MUST carry account + project + season
      // metadata filters (security-doc.md § Authorization & Data Isolation).
      "binding": "VECTOR_INDEX",
      "index_name": "storycrat-scripts"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        // Live dictation/conversation session state (PRD §7) — WebSocket
        // Hibernation + Alarms. Stubs are derived from the authenticated
        // user's ID; never from client-supplied raw IDs.
        "name": "SESSION_STATE",
        "class_name": "SessionState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionState"]
    }
  ],
  // Frontend: the built Vite app is served as static assets from this same
  // Worker. /api/* and /health always hit the Worker code; everything else
  // resolves to an asset or the SPA shell (client-side routing).
  "assets": {
    "directory": "frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  }
}
