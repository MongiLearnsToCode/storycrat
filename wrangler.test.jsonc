// Test-only Worker config: identical to wrangler.jsonc minus remote-only
// bindings (AI, Vectorize) and static assets, which local workerd cannot
// bind without uncatchable remote-proxy failures. lib/bindings.ts degrades
// gracefully when these are absent.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storycrat-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "storycrat-db",
      "database_id": "db33e2f3-c5ee-42cf-a39a-9bb33f3ae34f",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "4e97c8c3304743a080902eb545cac364"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PDFS",
      "bucket_name": "storycrat-exported-pdfs"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_STATE",
        "class_name": "SessionState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SessionState"
      ]
    }
  ]
}