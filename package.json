{
  "name": "storycrat",
  "version": "0.1.0",
  "private": true,
  "description": "Voice-first screenwriting companion — dictate, edit, and navigate a screenplay by voice.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:all": "concurrently -k -n api,web -c blue,yellow \"wrangler dev --port 8787\" \"npm --prefix frontend run dev\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:frontend": "npm --prefix frontend run test",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "5.20260823.1",
    "concurrently": "^10.0.5",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.27.0"
  },
  "allowScripts": {
    "workerd@1.20260820.1": true,
    "esbuild@0.28.1": true,
    "sharp@0.35.2": true,
    "workerd@1.20260815.1": true
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  }
}
